# 复制为 .env 并填写真实值（chmod 600）。.env 已在 .gitignore，永不提交。
PAGE_BASE=https://<用户名>.github.io/<仓库名>
WEIXIN_CHANNEL=openclaw-weixin
WEIXIN_ACCOUNT=<openclaw 微信账号 id>
WEIXIN_TARGET=<接收人/群 target>
OPENCLAW=/opt/wiki/openclaw-wrap.sh
OPENCLAW_ARGS=--noop
WIKI_AGENT_ID=wiki
# 可选:
# TZN=Asia/Shanghai
# AGENT_TIMEOUT=300
# WAIT_BUDGET=300
# GIT_BRANCH=main
